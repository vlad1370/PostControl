@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Guard")]
@model DashboardModel
@{
    ViewData["Title"] = "Панель охраны";
}

<div class="container-fluid mt-3">
    <div class="row">
        <!-- Левая колонка: Сканер -->
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5>📷 Сканер QR-кодов</h5>
                </div>
                <div class="card-body">
                    <div class="text-center">
                        <video id="video" autoplay playsinline
                               style="width: 100%; max-width: 400px; border-radius: 10px; background: #000;"></video>

                        <div id="result" class="mt-3"></div>

                        <div class="mt-2">
                            <button class="btn btn-success" onclick="startScanner()">
                                📷 Запустить камеру
                            </button>
                            <button class="btn btn-danger" onclick="stopScanner()">
                                ⏹ Остановить
                            </button>
                        </div>

                        <hr />
                        <div class="mt-3">
                            <h6>Или введите ID вручную:</h6>
                            <div class="input-group">
                                <input type="text" id="cardId" class="form-control" placeholder="TEST001" />
                                <button class="btn btn-primary" onclick="sendRequest()">
                                    Отправить
                                </button>
                            </div>
                        </div>
                        <div class="mt-3">
                            <h6>🔓 Разблокировать сотрудника:</h6>
                            <div class="input-group">
                                <input type="text" id="unblockCardId" class="form-control" placeholder="Введите ID карты" />
                                <button class="btn btn-warning" onclick="unblockUser()">Разблокировать</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Правая колонка: Журнал событий -->
        <div class="col-md-7">
            <div class="card shadow">
                <div class="card-header bg-dark text-white d-flex justify-content-between">
                    <h5>📊 Журнал событий</h5>
                    <div>
                        <span class="badge bg-success" id="allowedCount">✅ 0</span>
                        <span class="badge bg-danger" id="deniedCount">❌ 0</span>
                        <span class="badge bg-warning text-dark" id="blockedCount">🚫 0</span>
                    </div>
                </div>
                <div class="card-body" style="max-height: 600px; overflow-y: auto;">
                    <div id="events">
                        <div class="text-center text-muted">
                            ⏳ Ожидание событий...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@@zxing/library@0.18.3/umd/index.js"></script>

<script>
    // SignalR для реального времени
    const connection = new signalR.HubConnectionBuilder()
    .withUrl("/guardhub")
    .configureLogging(signalR.LogLevel.Information)
    .build();

    let allowed = 0, denied = 0, blocked = 0;

    connection.on("ReceiveEvent", (event) => {
    const events = document.getElementById('events');
    const div = document.createElement('div');

    // Убираем заглушку
    if (events.children.length === 1 && events.children[0].textContent.includes('Ожидание')) {
    events.innerHTML = '';
    }

    // Стиль в зависимости от события
    let bgColor = '';
    let icon = '';
    if (event.eventType === 'access_granted') {
    bgColor = 'border-left: 4px solid #28a745; background: #d4edda;';
    icon = '✅';
    allowed++;
    } else if (event.eventType === 'user_blocked') {
    bgColor = 'border-left: 4px solid #ffc107; background: #fff3cd;';
    icon = '🚫';
    blocked++;
    } else if (event.eventType === 'system') {
    bgColor = 'border-left: 4px solid #17a2b8; background: #d1ecf1;';
    icon = 'ℹ️';
    } else {
    bgColor = 'border-left: 4px solid #dc3545; background: #f8d7da;';
    icon = '❌';
    denied++;
    }

    div.className = 'event mb-2 p-2 rounded';
    div.style.cssText = bgColor;
    div.innerHTML = `
    <strong>${icon} ${event.userName}</strong>
    <span class="badge ${event.eventType === 'access_granted' ? 'bg-success' : 'bg-danger'} float-end">
    ${event.result}
    </span>
    <br/>
    <small class="text-muted">${new Date(event.timestamp).toLocaleString()}</small>
    <br/>
    <small>${event.reason}</small>
    `;

    events.insertBefore(div, events.firstChild);

    // Обновляем счётчики
    document.getElementById('allowedCount').textContent = '✅ ' + allowed;
    document.getElementById('deniedCount').textContent = '❌ ' + denied;
    document.getElementById('blockedCount').textContent = '🚫 ' + blocked;
    });

    connection.start()
    .then(() => console.log('Подключено к SignalR'))
    .catch(err => console.error(err));

    async function unblockUser() {
    const cardId = document.getElementById('unblockCardId').value.trim();
    if (!cardId) {
    alert('Введите ID карты');
    return;
    }

    try {
    const response = await fetch('/api/guard/unblock', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ cardId: cardId })
    });

    const data = await response.json();
    alert(data.message);
    } catch (error) {
    alert('Ошибка: ' + error.message);
    }
    }

    // --- Сканер QR ---
    let codeReader;
    let videoElement = document.getElementById('video');
    let resultDiv = document.getElementById('result');
    let isScanning = false;

    async function startScanner() {
    try {
    resultDiv.innerHTML = '<div class="alert alert-info">⏳ Запуск камеры...</div>';

    codeReader = new ZXing.BrowserMultiFormatReader();
    const videoInputDevices = await codeReader.listVideoInputDevices();

    if (videoInputDevices.length === 0) {
    resultDiv.innerHTML = '<div class="alert alert-danger">❌ Камера не найдена</div>';
    return;
    }

    isScanning = true;
    const selectedDeviceId = videoInputDevices[videoInputDevices.length - 1].deviceId;
    await codeReader.decodeFromVideoDevice(selectedDeviceId, videoElement, (result, err) => {
    if (result && isScanning) {
    document.getElementById('cardId').value = result.text;
    resultDiv.innerHTML = '<div class="alert alert-success">✅ QR-код распознан!</div>';
    sendRequest();
    stopScanner();
    }
    });

    resultDiv.innerHTML = '<div class="alert alert-info">📷 Наведите камеру на QR-код</div>';
    } catch (error) {
    resultDiv.innerHTML = `<div class="alert alert-danger">❌ Ошибка: ${error.message}</div>`;
    }
    }

    function stopScanner() {
    isScanning = false;
    if (codeReader) {
    codeReader.reset();
    }
    resultDiv.innerHTML = '<div class="alert alert-secondary">⏹ Сканирование остановлено</div>';
    }

    // --- Отправка запроса на сервер ---
    async function sendRequest() {
    const cardId = document.getElementById('cardId').value.trim();
    if (!cardId) {
    resultDiv.innerHTML = '<div class="alert alert-warning">❌ Введите ID карты</div>';
    return;
    }

    resultDiv.innerHTML = '<div class="alert alert-info">⏳ Отправка запроса...</div>';

    try {
    const response = await fetch('/api/guard/access', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ cardId: cardId, ppId: 1 })
    });

    const data = await response.json();

    if (data.allowed) {
    resultDiv.innerHTML = `<div class="alert alert-success">✅ ${data.message} - ${data.userName}</div>`;
    } else {
    resultDiv.innerHTML = `<div class="alert alert-danger">❌ ${data.message}</div>`;
    }
    } catch (error) {
    resultDiv.innerHTML = `<div class="alert alert-danger">❌ Ошибка: ${error.message}</div>`;
    }
    }

    // Отправка по Enter
    document.getElementById('cardId').addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
    sendRequest();
    }
    });
</script>