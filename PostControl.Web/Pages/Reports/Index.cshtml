@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Guard")]
@model IndexModel
@{
    ViewData["Title"] = "Отчёты по посещаемости";
}

<div class="container mt-4">
    <h2>📊 Отчёты по посещаемости</h2>

    <form method="get" class="row g-3 mb-4">
        <div class="col-md-3">
            <label>С</label>
            <input type="date" name="startDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label>По</label>
            <input type="date" name="endDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label>Сотрудник</label>
            <input type="text" name="search" class="form-control" placeholder="ФИО или ID" value="@Model.Search" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">Показать</button>
            <a href="/Reports/Export?startDate=@Model.StartDate.ToString("yyyy-MM-dd")&endDate=@Model.EndDate.ToString("yyyy-MM-dd")" class="btn btn-success ms-2">📥 CSV</a>
        </div>
    </form>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Дата/время</th>
                <th>Сотрудник</th>
                <th>ID карты</th>
                <th>Результат</th>
                <th>Причина</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model.Logs)
            {
                <tr>
                    <td>@log.Timestamp.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@log.UserName</td>
                    <td>@log.CardId</td>
                    <td>
                        <span class="badge @(log.Result == "allowed" ? "bg-success" : "bg-danger")">
                            @(log.Result == "allowed" ? "РАЗРЕШЁН" : "ЗАПРЕЩЁН")
                        </span>
                    </td>
                    <td>@log.Reason</td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Logs.Any())
    {
        <div class="alert alert-info">Нет записей за выбранный период</div>
    }

    <div class="mt-3">
        <strong>Всего: @Model.Logs.Count</strong> |
        <span class="text-success">Разрешено: @Model.Logs.Count(l => l.Result == "allowed")</span> |
        <span class="text-danger">Запрещено: @Model.Logs.Count(l => l.Result != "allowed")</span>
    </div>
</div>