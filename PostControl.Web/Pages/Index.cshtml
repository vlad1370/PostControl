@page
@{
    ViewData["Title"] = "Пост-Контроль";
}

<div class="text-center mt-5">
    <h1 class="display-4">🚪 Пост-Контроль</h1>
    <p class="lead">Система управления доступом на территорию</p>

    <div class="row mt-5 justify-content-center">
        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-body">
                    <h5 class="card-title">👤 Вход в систему</h5>
                    <div class="d-grid gap-2">
                        <a href="/Identity/Account/Login" class="btn btn-primary">Войти</a>
                        <a href="/Identity/Account/Register" class="btn btn-outline-primary">Регистрация</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>